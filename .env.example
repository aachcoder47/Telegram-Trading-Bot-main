# Telegram Configuration
API_ID=32885144
API_HASH=ebd2191c058373e02eca31aa70e2af70
SESSION_NAME=tg_session

# Exchange Selection (disabled for custodial wallet system)
# EXCHANGE=internal

# Proxy Configuration (Optional)
# PROXY_TYPE=SOCKS5
# PROXY_HOST=127.0.0.1
# PROXY_PORT=1080
# PROXY_USERNAME=username
# PROXY_PASSWORD=password

# Channel Configuration (disabled for custodial wallet system)
# The bot now uses direct commands instead of monitoring channels
# CHANNELS_CONFIG='[]'
# CHANNELS_FILE=./configs/channels.json

# Mistral AI Configuration (for signal extraction)
MISTRAL_API_KEY=your_mistral_api_key
MISTRAL_MODEL=mistral-large-latest
MISTRAL_TIMEOUT_SECS=299

# Image Upload Service (for processing images with Mistral)
UPLOAD_BASE=http://localhost:8080

# Exchange Configuration (disabled for custodial wallet system)
# The bot now uses internal trading instead of external exchanges
# XT_API_KEY=your_xt_api_key
# XT_SECRET=your_xt_secret
# XT_PASSWORD=your_xt_password
# XT_MARGIN_MODE=cross
# BITUNIX_API_KEY=your_bitunix_api_key
# BITUNIX_SECRET=your_bitunix_secret
# BITUNIX_BASE_URL=https://fapi.bitunix.com
# BITUNIX_LANGUAGE=en-US
# LBANK_API_KEY=your_lbank_api_key
# LBANK_SECRET=your_lbank_secret
# LBANK_PASSWORD=your_lbank_password

# Trading Configuration (for internal trading)
ORDER_QUOTE=USDT
ORDER_NOTIONAL=10
MAX_PRICE_DEVIATION_PCT=0.02
# Auto-execution is always enabled for internal trading
ENABLE_AUTO_EXECUTION=1

# Database and Storage
DB_PATH=./tg_channel.db
MEDIA_DIR=./output/media
BACKFILL=3

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=./output/logs/bot.log
LOG_BACKUP_COUNT=14

# System Configuration
HEARTBEAT_SECS=180
MAX_BACKOFF_SECS=300
SQL_BUSY_RETRIES=10
SQL_BUSY_SLEEP=0.2

# Fee Collection Settings (7.5% on withdrawals)
FEE_WALLET_ADDRESS=0xDEe1e2CD40F57747CB3eE3D863cDF1773905eB92
FEE_PERCENTAGE=7.5
MIN_DEPOSIT_USD=10.0

# Real Exchange Settings (Binance/Bybit) - Not used for blockchain wallet
BINANCE_API_KEY=
BINANCE_SECRET=
BYBIT_API_KEY=
BYBIT_SECRET=

# Real Trading Mode (0=simulation, 1=real trading)
ENABLE_REAL_TRADING=0

# Blockchain Network Configuration
BLOCKCHAIN_NETWORK=ethereum
# Options: ethereum, bsc, polygon
